
/**
 * Deterministic Discrete-Event Spacecraft Simulation Engine
 * Advances spacecraft orbital state, power collection, day/night eclipse transitions,
 * scientific data collection, ground station pass contacts, and telemetry logging.
 */

import { SeededRandom } from '../../utils/seededRandom.js';
import { calculateCircularOrbit, getOrbitPositionAndEclipse, getSubSatelliteCoordinates } from '../calculations/orbitalMechanics.js';
import { calculatePowerBudget } from '../calculations/power.js';
import { calculateDataBudget } from '../calculations/data.js';
import { calculateCommunicationsBudget } from '../calculations/communications.js';
import { calculateMissionScore } from './missionScoring.js';
import { CELESTIAL_BODIES } from '../constants/physics.js';
import { formatMET } from '../../utils/formatters.js';
import {
  getAnomalyProbability,
  getAvailableRandomAnomalies,
} from './anomalySystem.js';

/** Return a finite number, or null when evidence is absent/invalid. */
function readFiniteNumber(value) {
  if (value === null || value === undefined || value === '') return null;
  if (typeof value !== 'number' && typeof value !== 'string') return null;

  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : null;
}

/** Keep objective progress finite and within the 0-100% range. */
function clampProgress(value) {
  const parsed = readFiniteNumber(value);
  if (parsed === null) return 0;
  return Math.min(100, Math.max(0, parsed));
}

/** Progress for objectives that require an actual value to reach a minimum. */
function progressTowardMinimum(actualValue, targetValue) {
  const actual = readFiniteNumber(actualValue);
  const target = readFiniteNumber(targetValue);

  if (actual === null || target === null || target <= 0) return 0;
  return clampProgress((actual / target) * 100);
}

/** Progress for objectives that require a measured value to stay below a maximum. */
function progressWithinMaximum(actualValue, maximumValue) {
  const actual = readFiniteNumber(actualValue);
  const maximum = readFiniteNumber(maximumValue);

  if (actual === null || maximum === null || maximum <= 0 || actual < 0) return 0;
  if (actual <= maximum) return 100;
  return clampProgress((maximum / actual) * 100);
}

export const SIMULATION_PHASES = {
  PRE_LAUNCH: 'PRE_LAUNCH',
  LAUNCH: 'LAUNCH',
  ORBIT_INSERTION: 'ORBIT_INSERTION',
  COMMISSIONING: 'COMMISSIONING',
  PRIMARY_OPS: 'PRIMARY_OPS',
  COMPLETED: 'COMPLETED',
  FAILED: 'FAILED',
};

export class SimulationEngine {

  // Accept and store validation metrics for final mission scoring.
  // Existing two-argument constructor calls remain compatible.

  constructor(mission, seed = 123456789, validationMetrics = null) {
    this.mission = mission;
    this.seed = seed;

    this.validationMetrics =
      validationMetrics && typeof validationMetrics === 'object'
        ? validationMetrics
        : null;

    this.rng = new SeededRandom(seed);
    this.reset();
  }

  reset() {
    this.rng.reset();
    const dest = this.mission?.destination || 'earth';
    const alt = this.mission?.orbit?.altitudeKm || 500;
    const inc = this.mission?.orbit?.inclinationDeg || 45;

    this.orbitCalc = calculateCircularOrbit(dest, alt, inc);
    this.celestialBody = CELESTIAL_BODIES[dest] || CELESTIAL_BODIES.earth;

    // Preserve an explicitly configured zero battery capacity.
    // Apply the 1000 Wh fallback only when the capacity is missing.
    const configuredBatteryCapacityWh = this.mission?.spacecraft?.battery?.capacityWh;
    const parsedBatteryCapacityWh = configuredBatteryCapacityWh == null
      ? 1000
      : Number(configuredBatteryCapacityWh);

    const totalBatteryCapacityWh = Number.isFinite(parsedBatteryCapacityWh) && parsedBatteryCapacityWh >= 0
      ? parsedBatteryCapacityWh
      : 0;

    // Preserve an explicitly configured zero storage capacity.
    // Use the existing 64 GB fallback only when the value is missing.
    const configuredStorageCapacityGB = this.mission?.spacecraft?.computing?.storageCapacityGB;
    const parsedStorageCapacityGB = configuredStorageCapacityGB == null
      ? 64
      : Number(configuredStorageCapacityGB);

    const storageCapacityGB = Number.isFinite(parsedStorageCapacityGB) && parsedStorageCapacityGB >= 0
      ? parsedStorageCapacityGB
      : 0;

    this.state = {
      status: SIMULATION_PHASES.PRE_LAUNCH,
      missionTimeSeconds: 0,
      targetDurationSeconds: (this.mission?.durationDays || 90) * 86400,
      isPaused: true,
      simulationSpeed: 1,

      // Orbit & Position
      orbitAngleRad: 0,
      latitude: 0,
      longitude: 0,
      isInEclipse: false,
      altitudeKm: alt,

      // Power & Battery
      currentPowerGenerationW: 0,
      currentPowerConsumptionW: 0,
      batteryEnergyWh: totalBatteryCapacityWh,
      batteryCapacityWh: totalBatteryCapacityWh,
      batteryPercent: totalBatteryCapacityWh > 0 ? 100 : 0,

      // Highest observed battery discharge since the simulation started.
      maxObservedBatteryDoDPercent: 0,

      // Propulsion and orbital insertion state.
      achievedDeltaVMs: 0,
      orbitalInsertionComplete: false,
      orbitalInsertionStatus: 'UNVERIFIED',
      insertionWarningLogged: false,
      propellantConsumedKg: 0,
      propellantRemainingKg: readFiniteNumber(
        this.mission?.spacecraft?.propulsion?.initialPropellantKg
      ) ?? 0,

      // Data & Storage
      onboardStoredDataMB: 0,
      maxStorageMB: storageCapacityGB * 1024,
      totalDataCollectedMB: 0,
      totalDataDownlinkedMB: 0,
      totalDataDroppedMB: 0,
      storageOverflowAlerted: false,

      // Comms & Contact
      isContactingGroundStation: false,
      activeGroundStation: null,
      currentDownlinkRateMbps: 0,
      linkMarginDb: 12.5,

      // Subsystems Health (0-100%)
      subsystemHealth: {
        bus: 100,
        power: 100,
        battery: 100,
        instruments: 100,
        comms: 100,
        adcs: 100,
        thermal: 100,
        propulsion: 100,
      },

      // Objectives tracking
      activeAnomalies: [],
      objectivesProgress: {},
      events: [],
      telemetryHistory: [],
      score: null,
      failureReason: null,
    };

    // Pre-populate objectives.
    (this.mission?.objectives || []).forEach(obj => {
      this.state.objectivesProgress[obj.id] = 0;
    });

    this.logEvent(
      'INFO',
      'PRE-LAUNCH',
      'Spacecraft pre-flight diagnostics verified. All systems nominal on pad.'
    );
  }

  logEvent(severity, category, message) {
    const event = {
      id: `evt-${Date.now()}-${this.rng.intRange(1000, 9999)}`,
      timeSeconds: this.state.missionTimeSeconds,
      timeFormatted: formatMET(this.state.missionTimeSeconds),
      severity,
      category,
      message,
    };

    this.state.events.unshift(event);

    if (this.state.events.length > 150) {
      this.state.events.pop();
    }
  }

  start() {
    this.state.isPaused = false;

    if (this.state.status === SIMULATION_PHASES.PRE_LAUNCH) {
      this.state.status = SIMULATION_PHASES.LAUNCH;

      this.logEvent(
        'MILESTONE',
        'LAUNCH',
        `Ignition and Liftoff confirmed aboard ${this.mission?.launchVehicle?.name || 'Launch Vehicle'}!`
      );
    }
  }

  pause() {
    this.state.isPaused = true;
  }

  resume() {
    this.state.isPaused = false;
  }

  setSpeed(speedMultiplier) {
    this.state.simulationSpeed = Math.max(1, Math.min(20, speedMultiplier));
  }

  /**
   * Advances the simulation by a discrete delta-time in seconds.
   * Scaled by simulationSpeed.
   */
  step(baseDeltaSeconds = 60) {

    if (
      this.state.isPaused ||
      this.state.status === SIMULATION_PHASES.COMPLETED ||
      this.state.status === SIMULATION_PHASES.FAILED
    ) {
      return this.state;
    }

    const dt = baseDeltaSeconds * this.state.simulationSpeed;
    this.state.missionTimeSeconds += dt;

    // 1. Mission Phase Transitions
    const t = this.state.missionTimeSeconds;

    if (this.state.status === SIMULATION_PHASES.LAUNCH && t >= 600) {
      this.state.status = SIMULATION_PHASES.ORBIT_INSERTION;

      this.logEvent(
        'MILESTONE',
        'STAGE SEP',
        'Second stage shutdown. Spacecraft payload separated into preliminary orbit.'
      );

    } else if (this.state.status === SIMULATION_PHASES.ORBIT_INSERTION && t >= 1800) {

      const insertionResult = this.executeOrbitalInsertion();

      if (insertionResult === false) {
        this.state.status = SIMULATION_PHASES.FAILED;
        this.updateObjectivesProgress();
        this.evaluateFinalScore();
        return this.state;
      }

      // Null means propulsion capability is unverified.
      // Remain in ORBIT_INSERTION and retry on a later tick.
      // Never start commissioning without verified insertion.
      if (insertionResult === true) {
        this.state.status = SIMULATION_PHASES.COMMISSIONING;

        this.logEvent(
          'MILESTONE',
          'DEPLOYMENT',
          'Spacecraft propulsion manoeuvre verified. Solar array deployment and commissioning sequence initiated.'
        );
      }

    } else if (this.state.status === SIMULATION_PHASES.COMMISSIONING && t >= 7200) {
      this.state.status = SIMULATION_PHASES.PRIMARY_OPS;

      this.logEvent(
        'SUCCESS',
        'SCIENCE OPS',
        'Initial commissioning complete. Primary payload science observation sequence initiated.'
      );
    }

    // Process active anomalies before resource calculations.
    this.checkAnomalies(dt);
    // 2. Orbital Kinematics
    const meanMotion = this.orbitCalc.meanMotionRadPerSec;

    this.state.orbitAngleRad =
      (this.state.orbitAngleRad + (meanMotion * dt)) % (2 * Math.PI);

    // Calculate sub-satellite ground coordinates.
    const incRad =
      (this.orbitCalc.inclinationDeg * Math.PI) / 180;

    const coords = getSubSatelliteCoordinates(
      this.state.orbitAngleRad,
      incRad,
      this.state.missionTimeSeconds,
      this.celestialBody.rotationPeriod
    );

    this.state.latitude = coords.latitude;
    this.state.longitude = coords.longitude;

    // Eclipse geometry.
    const orbitPos = getOrbitPositionAndEclipse(
      this.orbitCalc.radiusM,
      incRad,
      this.state.orbitAngleRad,
      this.celestialBody.radius
    );

    const wasInEclipse = this.state.isInEclipse;
    this.state.isInEclipse = orbitPos.isInEclipse;

    if (!wasInEclipse && this.state.isInEclipse) {
      this.logEvent(
        'INFO',
        'ECLIPSE ENTRY',
        'Spacecraft entered planetary shadow (umbra). Solar power offline, switching to secondary battery.'
      );

    } else if (wasInEclipse && !this.state.isInEclipse) {
      this.logEvent(
        'INFO',
        'SUNLIGHT EXIT',
        'Sunrise confirmed. Solar arrays generating power; recharging battery reserve.'
      );
    }

    // 3. Ground Station Contact Window Evaluation.
    // Determine contact before selecting the spacecraft's operating power load.
    this.updateGroundStationContact();

    // 4. Power Generation & Consumption
    const powerConfig = calculatePowerBudget({
      powerSource: this.mission?.spacecraft?.power,
      battery: this.mission?.spacecraft?.battery,
      instruments: this.mission?.spacecraft?.instruments,
      comms: this.mission?.spacecraft?.comms,
      adcs: this.mission?.spacecraft?.adcs,
      computing: this.mission?.spacecraft?.computing,
      thermal: this.mission?.spacecraft?.thermal,
      orbit: this.orbitCalc,
      bodyId: this.mission?.destination,
    });

    // A ground-station contact enables the transmitter during primary operations.
    const communicationTransmissionActive =
      this.state.status === SIMULATION_PHASES.PRIMARY_OPS &&
      this.state.isContactingGroundStation;

    // The daylight load includes communication standby power, while peakLoadW
    // includes full transmitter power.
    const daylightLoadW = Number(powerConfig.daylightLoadW);
    const peakLoadW = Number(powerConfig.peakLoadW);

    const transmissionPowerIncrementW =
      Number.isFinite(daylightLoadW) && Number.isFinite(peakLoadW)
        ? Math.max(0, peakLoadW - daylightLoadW)
        : 0;

    if (this.state.status === SIMULATION_PHASES.LAUNCH) {

      // Solar arrays are assumed stowed under the launch vehicle fairing.
      // An RTG, however, can provide continuous power during launch.
      this.state.currentPowerGenerationW =
        this.mission?.spacecraft?.power?.isRTG
          ? powerConfig.eclipseGenerationW
          : 0;

      this.state.currentPowerConsumptionW =
        powerConfig.busBasePowerW * 0.5;

    } else if (this.state.isInEclipse) {

      // Eclipse load already includes communication standby power.
      // Add only the incremental transmitter load when contact is active.
      this.state.currentPowerGenerationW =
        powerConfig.eclipseGenerationW;

      this.state.currentPowerConsumptionW =
        powerConfig.eclipseLoadW +
        (communicationTransmissionActive ? transmissionPowerIncrementW : 0);

    } else {

      // Daylight: use the full peak load during transmission.
      this.state.currentPowerGenerationW =
        powerConfig.daylightGenerationW;

      this.state.currentPowerConsumptionW =
        communicationTransmissionActive
          ? powerConfig.peakLoadW
          : powerConfig.daylightLoadW;
    }

    // Battery Integration: dE = (P_gen - P_load) * dt
    const netPowerWatts =
      this.state.currentPowerGenerationW -
      this.state.currentPowerConsumptionW;

    const netEnergyWh =
      (netPowerWatts * dt) / 3600;

    // Keep battery energy within its installed capacity.
    // A spacecraft with no battery stores no energy, even if its power
    // source generates a surplus.
    if (this.state.batteryCapacityWh > 0) {

      this.state.batteryEnergyWh = Math.max(
        0,
        Math.min(
          this.state.batteryCapacityWh,
          this.state.batteryEnergyWh + netEnergyWh
        )
      );

      this.state.batteryPercent = Math.min(
        100,
        Math.max(
          0,
          (this.state.batteryEnergyWh / this.state.batteryCapacityWh) * 100
        )
      );

    } else {

      this.state.batteryEnergyWh = 0;
      this.state.batteryPercent = 0;
    }

    // Record the deepest discharge actually observed during the simulation.
    // An absent battery is not assigned an artificial 100% DoD observation.
    if (this.state.batteryCapacityWh > 0) {
      const observedDoDPercent = 100 - this.state.batteryPercent;

      this.state.maxObservedBatteryDoDPercent = Math.max(
        this.state.maxObservedBatteryDoDPercent,
        observedDoDPercent
      );
    }

    // A depleted or absent battery is only fatal when available generation
    // cannot support the current spacecraft load.
    const powerDeficitW =
      this.state.currentPowerConsumptionW -
      this.state.currentPowerGenerationW;

    const batteryUnavailableOrDepleted =
      this.state.batteryCapacityWh <= 0 ||
      this.state.batteryEnergyWh <= 0;

    const spacecraftHasPowerShortfall =
      powerDeficitW > 1e-9 &&
      batteryUnavailableOrDepleted;

    if (spacecraftHasPowerShortfall) {

      this.state.status = SIMULATION_PHASES.FAILED;

      this.state.failureReason =
        `Available generation (${this.state.currentPowerGenerationW.toFixed(1)} W) and stored battery energy (${this.state.batteryEnergyWh.toFixed(1)} Wh) cannot support the current load (${this.state.currentPowerConsumptionW.toFixed(1)} W).`;

      this.logEvent(
        'CRITICAL',
        'POWER LOSS',
        this.state.failureReason
      );

      // Capture the latest objective evidence before computing a failure score.
      this.updateObjectivesProgress();

      this.evaluateFinalScore();

      return this.state;
    }

    // 5. Scientific Data Generation & Downlink
    if (this.state.status === SIMULATION_PHASES.PRIMARY_OPS) {

      const dataDutyCycleFraction = 0.6;

      const dataCalc = calculateDataBudget({
        instruments: this.mission?.spacecraft?.instruments || [],
        computing: this.mission?.spacecraft?.computing,
        dutyCycleFraction: dataDutyCycleFraction,
      });

      // Apply the validated duty cycle.
      const effectiveDataRateMBps =
        Number(dataCalc.effectiveRateMBps);

      const safeDataRateMBps =
        Number.isFinite(effectiveDataRateMBps) && effectiveDataRateMBps > 0
          ? effectiveDataRateMBps
          : 0;

      // calculateDataBudget uses the supplied duty cycle but does not return
      // it in its result object. Validate the actual input here; reading a
      // nonexistent dataCalc.dutyCycleFraction would silently force data
      // generation to zero for every simulation tick.
      const safeDutyCycle =
        Number.isFinite(dataDutyCycleFraction)
          ? Math.min(1, Math.max(0, dataDutyCycleFraction))
          : 0;

      // Average generated data for this simulation tick (MB).
      const dataGenTickMB =
        safeDataRateMBps * dt * safeDutyCycle;

      this.state.totalDataCollectedMB += dataGenTickMB;

      // Store only the amount that fits in the remaining onboard capacity.
      // Any excess is explicitly recorded as dropped scientific data.
      const availableStorageMB = Math.max(
        0,
        this.state.maxStorageMB - this.state.onboardStoredDataMB
      );

      const acceptedDataMB =
        Math.min(dataGenTickMB, availableStorageMB);

      const droppedDataMB =
        Math.max(0, dataGenTickMB - acceptedDataMB);

      this.state.onboardStoredDataMB += acceptedDataMB;
      this.state.totalDataDroppedMB += droppedDataMB;

      if (droppedDataMB > 0 && !this.state.storageOverflowAlerted) {

        this.logEvent(
          'WARNING',
          'DATA STORAGE OVERFLOW',
          `Onboard storage is full. ${droppedDataMB.toFixed(2)} MB of newly generated science data could not be stored.`
        );

        this.state.storageOverflowAlerted = true;
      }

      // Downlink execution if contacting a ground station.
      if (this.state.isContactingGroundStation) {

        const commsCalc = calculateCommunicationsBudget({
          comms: this.mission?.spacecraft?.comms,
          bodyId: this.mission?.destination,
          altitudeKm: this.orbitCalc.altitudeKm,
        });

        const reportedDownlinkRateMbps =
          Number(commsCalc.effectiveDownlinkRateMbps);

        const safeDownlinkRateMbps =
          Number.isFinite(reportedDownlinkRateMbps) && reportedDownlinkRateMbps > 0
            ? reportedDownlinkRateMbps
            : 0;

        const reportedDownlinkRateMBps =
          Number(commsCalc.effectiveDownlinkRateMBps);

        const safeDownlinkRateMBps =
          Number.isFinite(reportedDownlinkRateMBps) && reportedDownlinkRateMBps > 0
            ? reportedDownlinkRateMBps
            : 0;

        this.state.currentDownlinkRateMbps =
          safeDownlinkRateMbps;

        const downlinkCapacityMB =
          safeDownlinkRateMBps * dt;

        const actualDownlinkedMB = Math.min(
          this.state.onboardStoredDataMB,
          downlinkCapacityMB
        );

        this.state.onboardStoredDataMB = Math.max(
          0,
          this.state.onboardStoredDataMB - actualDownlinkedMB
        );

        this.state.totalDataDownlinkedMB += actualDownlinkedMB;

      } else {

        this.state.currentDownlinkRateMbps = 0;
      }
    }

    // 7. Update Objective Progress
    this.updateObjectivesProgress();

    // 8. Log Periodic Telemetry History
    if (
      this.state.telemetryHistory.length === 0 ||
      (t - this.state.telemetryHistory[
        this.state.telemetryHistory.length - 1
      ].timeSeconds) >= 180
    ) {
      this.recordTelemetrySnapshot();
    }

    // 9. Mission Duration Completion Check
    if (this.state.missionTimeSeconds >= this.state.targetDurationSeconds) {
      const requiredDeltaVMs = readFiniteNumber(this.mission?.deltaVRequiredMs);
      const insertionRequired = requiredDeltaVMs !== null && requiredDeltaVMs > 0;

      if (insertionRequired && !this.state.orbitalInsertionComplete) {
        this.state.status = SIMULATION_PHASES.FAILED;
        this.state.orbitalInsertionStatus = 'UNVERIFIED';
        this.state.failureReason =
          'Orbital insertion was not verified before the mission duration expired.';

        this.logEvent(
          'CRITICAL',
          'ORBIT INSERTION TIMEOUT',
          this.state.failureReason
        );

        this.updateObjectivesProgress();
        this.evaluateFinalScore();
        return this.state;
      }

      this.state.status = SIMULATION_PHASES.COMPLETED;

      this.logEvent(
        'SUCCESS',
        'MISSION COMPLETE',
        'Planned mission duration reached! Final science telemetry verified and compiled.'
      );

      this.evaluateFinalScore();
    }

    return this.state;
  }

  /**
   * Executes the planned idealized propulsion manoeuvre using the validated
   * propellant inventory and Tsiolkovsky delta-V capability.
   *
   * This is a single-burn game model. It is not a finite-burn trajectory
   * integrator and does not model gravity losses, thrust direction, staging,
   * or planetary capture dynamics.
   *
   * Returns true when insertion is verified or not required, false when
   * quantified propellant evidence proves the manoeuvre is infeasible, and
   * null when the available evidence is insufficient to verify capability.
   * Missing evidence never grants permission to enter commissioning.
   */
  executeOrbitalInsertion() {
    const requiredDeltaVMs = readFiniteNumber(
      this.mission?.deltaVRequiredMs
    );

    if (requiredDeltaVMs === null || requiredDeltaVMs <= 0) {
      this.state.orbitalInsertionComplete = true;
      this.state.orbitalInsertionStatus = 'NOT_REQUIRED';

      this.logEvent(
        'INFO',
        'ORBIT INSERTION',
        'No positive mission delta-V requirement was configured; no propulsion insertion burn was executed.'
      );

      return true;
    }

    const massMetrics = this.validationMetrics?.mass;

    const availableDeltaVMs = readFiniteNumber(
      massMetrics?.availableDeltaVMs
    );

    if (availableDeltaVMs === null) {
      this.state.orbitalInsertionComplete = false;
      this.state.orbitalInsertionStatus = 'UNVERIFIED';

      if (!this.state.insertionWarningLogged) {
        this.logEvent(
          'WARNING',
          'ORBIT INSERTION',
          'Insertion manoeuvre remains unverified because configured propellant capability is unavailable. Commissioning is blocked until propulsion evidence is provided.'
        );

        this.state.insertionWarningLogged = true;
      }

      // Tri-state result: null means not verified, not successful.
      return null;
    }

    const achievedDeltaVMs = Math.max(
      0,
      Math.min(requiredDeltaVMs, availableDeltaVMs)
    );

    this.state.achievedDeltaVMs = achievedDeltaVMs;

    const configuredPropellantKg = readFiniteNumber(
      massMetrics?.configuredPropellantMassKg
    );

    const requiredPropellantKg = readFiniteNumber(
      massMetrics?.requiredPropellantMassKg
    );

    if (configuredPropellantKg !== null) {
      const consumedPropellantKg = requiredPropellantKg !== null
        ? Math.min(configuredPropellantKg, requiredPropellantKg)
        : configuredPropellantKg;

      this.state.propellantConsumedKg = consumedPropellantKg;

      this.state.propellantRemainingKg = Math.max(
        0,
        configuredPropellantKg - consumedPropellantKg
      );
    }

    if (availableDeltaVMs + 1e-9 < requiredDeltaVMs) {
      this.state.orbitalInsertionComplete = false;
      this.state.orbitalInsertionStatus = 'FAILED';
      this.state.propellantRemainingKg = 0;

      this.state.failureReason =
        `Orbital insertion failed: configured propulsion can provide ${availableDeltaVMs.toFixed(1)} m/s, but the mission requires ${requiredDeltaVMs.toFixed(1)} m/s.`;

      this.logEvent(
        'CRITICAL',
        'ORBIT INSERTION FAILURE',
        this.state.failureReason
      );

      return false;
    }

    this.state.achievedDeltaVMs = requiredDeltaVMs;
    this.state.orbitalInsertionComplete = true;
    this.state.orbitalInsertionStatus = 'VERIFIED';
    this.state.insertionWarningLogged = false;

    this.logEvent(
      'SUCCESS',
      'ORBIT INSERTION',
      `Propulsion manoeuvre completed. ${requiredDeltaVMs.toFixed(1)} m/s achieved with ${this.state.propellantRemainingKg.toFixed(1)} kg of modelled propellant remaining.`
    );

    return true;
  }

  updateGroundStationContact() {

    const stations =
      this.celestialBody.groundStations || [];

    let contacting = false;
    let contactStation = null;

    if (this.celestialBody.id === 'earth') {

      // In LEO, satellite must pass within horizon visibility angle.
      for (const st of stations) {

        const dLat =
          Math.abs(this.state.latitude - st.lat);

        const dLon =
          Math.abs(this.state.longitude - st.lon);

        // Simple angular distance threshold for line of sight.
        if (
          dLat < 18 &&
          (dLon < 22 || dLon > (360 - 22))
        ) {
          contacting = true;
          contactStation = st.name;
          break;
        }
      }

    } else {

      // Deep Space Network (DSN) link visibility.
      const dsnWindow = Math.sin(
        (this.state.missionTimeSeconds / 86400) *
        (2 * Math.PI) * 2
      );

      if (dsnWindow > -0.2) {
        contacting = true;
        contactStation =
          'Deep Space Network 70m Antenna Array';
      }
    }

    if (!this.state.isContactingGroundStation && contacting) {

      this.logEvent(
        'INFO',
        'GROUND CONTACT',
        `Carrier lock established with ${contactStation}. High-rate science telemetry downlink active.`
      );

    } else if (this.state.isContactingGroundStation && !contacting) {

      this.logEvent(
        'INFO',
        'CONTACT LOSS',
        'AOS/LOS transition. Spacecraft passed beyond ground station horizon.'
      );
    }

    this.state.isContactingGroundStation = contacting;
    this.state.activeGroundStation = contactStation;
  }

  /**
   * Processes temporary anomalies using simulated mission time.
   * Expired anomalies restore their recorded subsystem-health impact.
   */
  checkAnomalies(dt) {
    const now = this.state.missionTimeSeconds;
    const remainingAnomalies = [];

    // 1. Expire anomalies and restore their applied health impact.
    for (const anomaly of this.state.activeAnomalies || []) {
      if (anomaly.expiresAtSeconds <= now) {
        const currentHealth =
          readFiniteNumber(
            this.state.subsystemHealth?.[anomaly.subsystem]
          ) ?? 100;

        this.state.subsystemHealth[anomaly.subsystem] = Math.min(
          100,
          currentHealth + anomaly.appliedHealthImpact
        );

        this.logEvent(
          'SUCCESS',
          'ANOMALY RECOVERY',
          anomaly.recoveryMessage
        );
      } else {
        remainingAnomalies.push(anomaly);
      }
    }

    this.state.activeAnomalies = remainingAnomalies;

    // 2. Trigger anomalies only during primary operations.
    if (
      this.state.status !== SIMULATION_PHASES.PRIMARY_OPS ||
      !Number.isFinite(dt) ||
      dt <= 0
    ) {
      return;
    }

    // 3. Prevent duplicate instances of an active anomaly.
    const activeIds = new Set(
      remainingAnomalies.map((anomaly) => anomaly.id)
    );

    const availableAnomalies =
      getAvailableRandomAnomalies(this.mission).filter(
        (anomaly) => !activeIds.has(anomaly.id)
      );

    if (availableAnomalies.length === 0) {
      return;
    }

    // 4. Calculate probability using gameplay difficulty.
    const probability = getAnomalyProbability(
      dt,
      this.mission?.gameplayDifficulty || 'standard'
    );

    if (!this.rng.chance(probability)) {
      return;
    }

    // 5. Select a compatible anomaly deterministically.
    const anomaly = this.rng.choice(availableAnomalies);

    if (!anomaly) {
      return;
    }

    // 6. Apply subsystem-health impact, retaining the actual amount.
    const currentHealth =
      readFiniteNumber(
        this.state.subsystemHealth?.[anomaly.subsystem]
      ) ?? 100;

    const newHealth = Math.max(
      60,
      currentHealth - anomaly.healthImpact
    );

    const appliedHealthImpact = currentHealth - newHealth;

    this.state.subsystemHealth[anomaly.subsystem] = newHealth;

    // 7. Register the temporary anomaly and its expiry time.
    this.state.activeAnomalies.push({
      ...anomaly,
      startedAtSeconds: now,
      expiresAtSeconds: now + anomaly.durationSeconds,
      appliedHealthImpact,
    });

    this.logEvent(
      'WARNING',
      'ANOMALY',
      anomaly.message
    );
  }
  updateObjectivesProgress() {
    const objectives = Array.isArray(this.mission?.objectives)
      ? this.mission.objectives
      : [];

    const totalCollectedGB = Math.max(
      0,
      (readFiniteNumber(this.state.totalDataCollectedMB) ?? 0) / 1024
    );

    const totalDownlinkedGB = Math.max(
      0,
      (readFiniteNumber(this.state.totalDataDownlinkedMB) ?? 0) / 1024
    );

    const powerMetrics = this.validationMetrics?.power;
    const budgetMetrics = this.validationMetrics?.budget;
    const thermalMetrics = this.validationMetrics?.thermal;

    objectives.forEach((objective) => {
      if (!objective || objective.id === null || objective.id === undefined) {
        return;
      }

      let progress = 0;

      switch (objective.type) {

        case 'data_volume': {
          // Data-volume objectives measure collection by default. A campaign
          // that explicitly requires returned data can set dataSource to
          // 'downlinked' on that objective.
          const dataSource = String(objective.dataSource || 'collected').toLowerCase();

          const measuredDataGB = dataSource === 'downlinked'
            ? totalDownlinkedGB
            : totalCollectedGB;

          const targetGB = readFiniteNumber(objective.targetValueGB);

          progress = progressTowardMinimum(measuredDataGB, targetGB);
          break;
        }

        case 'downlink_efficiency': {
          const collectedMB = Math.max(
            0,
            readFiniteNumber(this.state.totalDataCollectedMB) ?? 0
          );

          const downlinkedMB = Math.max(
            0,
            readFiniteNumber(this.state.totalDataDownlinkedMB) ?? 0
          );

          const targetPercent = readFiniteNumber(objective.targetValuePercent);

          const actualPercent = collectedMB > 0
            ? (downlinkedMB / collectedMB) * 100
            : 0;

          progress = progressTowardMinimum(actualPercent, targetPercent);
          break;
        }

        case 'battery_health': {
          // This objective is a maximum depth-of-discharge requirement,
          // not a threshold on instantaneous battery state-of-charge.
          const batteryCapacityWh = readFiniteNumber(this.state.batteryCapacityWh);
          const targetMaxDoD = readFiniteNumber(objective.targetValueMaxDoD);

          const normalizedTargetMaxDoD = targetMaxDoD !== null && targetMaxDoD > 1
            ? targetMaxDoD / 100
            : targetMaxDoD;

          if (batteryCapacityWh !== null && batteryCapacityWh > 0) {
            const observedDoDPercent = readFiniteNumber(
              this.state.maxObservedBatteryDoDPercent
            ) ?? 0;

            const observedDoDFraction = observedDoDPercent / 100;

            const validatedDoD = readFiniteNumber(powerMetrics?.dodReached);
            const validatedDoDPercent = readFiniteNumber(powerMetrics?.dodPercent);

            const validatedDoDFraction = validatedDoD !== null
              ? validatedDoD
              : (validatedDoDPercent !== null ? validatedDoDPercent / 100 : null);

            const actualDoDFraction = validatedDoDFraction === null
              ? observedDoDFraction
              : Math.max(observedDoDFraction, validatedDoDFraction);

            progress = progressWithinMaximum(
              actualDoDFraction,
              normalizedTargetMaxDoD
            );
          }

          break;
        }

        case 'budget_performance': {
          const totalCost = readFiniteNumber(budgetMetrics?.totalCost);
          const budgetLimit = readFiniteNumber(this.mission?.budgetLimitUSD);

          // The current Earth campaign description requires at least 10% of
          // the allocated budget to remain as contingency. Campaigns can
          // override this threshold with objective.targetReservePercent.
          const requiredReservePercent =
            readFiniteNumber(objective.targetReservePercent) ?? 10;

          if (
            totalCost !== null &&
            totalCost >= 0 &&
            budgetLimit !== null &&
            budgetLimit > 0 &&
            requiredReservePercent > 0
          ) {
            const actualReservePercent =
              ((budgetLimit - totalCost) / budgetLimit) * 100;

            progress = progressTowardMinimum(
              actualReservePercent,
              requiredReservePercent
            );
          }

          break;
        }

        case 'power_margin': {
          const actualPowerMarginPercent = readFiniteNumber(
            powerMetrics?.daylightPowerMarginPercent
          );

          const targetPowerMarginPercent = readFiniteNumber(objective.targetValuePercent);

          progress = progressTowardMinimum(
            actualPowerMarginPercent,
            targetPowerMarginPercent
          );

          break;
        }

        case 'thermal_margin': {
          // The current validation engine does not yet calculate thermal
          // margin. This contract accepts that metric once implemented;
          // missing evidence deliberately earns no progress.
          const actualThermalMarginW = readFiniteNumber(
            thermalMetrics?.thermalMarginW
          );

          const targetThermalMarginW = readFiniteNumber(objective.targetValueMinWatts);

          progress = progressTowardMinimum(
            actualThermalMarginW,
            targetThermalMarginW
          );

          break;
        }

        case 'orbital_insertion': {
          // A scripted mission phase is not proof that the required delta-V
          // manoeuvre occurred. The propulsion model must report achievedDeltaVMs.
          const achievedDeltaVMs = readFiniteNumber(this.state.achievedDeltaVMs);
          const targetDeltaVMs = readFiniteNumber(objective.targetValueDeltaVMs);

          progress = progressTowardMinimum(
            achievedDeltaVMs,
            targetDeltaVMs
          );

          break;
        }

        case 'operational_readiness': {
          // Use the explicit validation metric; never substitute elapsed time.
          const readinessPercent = readFiniteNumber(
            this.validationMetrics?.operationalReadinessPercent
          );

          const targetReadinessPercent = readFiniteNumber(objective.targetValuePercent);

          progress = progressTowardMinimum(
            readinessPercent,
            targetReadinessPercent
          );

          break;
        }

        default:
          // Unknown objective types remain uncredited until an objective-
          // specific engineering metric is implemented.
          progress = 0;
      }

      this.state.objectivesProgress[objective.id] = Math.round(
        clampProgress(progress)
      );
    });
  }

  recordTelemetrySnapshot() {

    const snapshot = {
      timeSeconds:
        this.state.missionTimeSeconds,

      timeFormatted:
        formatMET(this.state.missionTimeSeconds),

      powerGenerationW:
        Math.round(this.state.currentPowerGenerationW),

      powerConsumptionW:
        Math.round(this.state.currentPowerConsumptionW),

      batteryPercent:
        Number(this.state.batteryPercent.toFixed(1)),

      maxObservedBatteryDoDPercent:
        Number(this.state.maxObservedBatteryDoDPercent.toFixed(1)),

      achievedDeltaVMs:
        Number(this.state.achievedDeltaVMs.toFixed(1)),

      orbitalInsertionComplete:
        this.state.orbitalInsertionComplete,

      orbitalInsertionStatus:
        this.state.orbitalInsertionStatus,

      propellantConsumedKg:
        Number(this.state.propellantConsumedKg.toFixed(2)),

      propellantRemainingKg:
        Number(this.state.propellantRemainingKg.toFixed(2)),

      batteryEnergyWh:
        Math.round(this.state.batteryEnergyWh),

      storedDataMB:
        Math.round(this.state.onboardStoredDataMB),

      totalDataCollectedMB:
        Number(this.state.totalDataCollectedMB.toFixed(2)),

      totalDataDroppedMB:
        Number(this.state.totalDataDroppedMB.toFixed(2)),

      downlinkMbps:
        Number(this.state.currentDownlinkRateMbps.toFixed(2)),

      totalDownlinkedGB:
        Number(
          (this.state.totalDataDownlinkedMB / 1024).toFixed(2)
        ),

      isInEclipse:
        this.state.isInEclipse,

      hasContact:
        this.state.isContactingGroundStation,
    };

    this.state.telemetryHistory.push(snapshot);

    if (this.state.telemetryHistory.length > 200) {
      this.state.telemetryHistory.shift();
    }
  }

  // Pass the actual stored validation metrics into the scoring engine.
  // Do not replace validationMetrics with null.

  evaluateFinalScore() {
    this.state.score = calculateMissionScore({
      mission: this.mission,
      simulationState: this.state,
      validationMetrics: this.validationMetrics,
    });

    return this.state.score;
  }
}
